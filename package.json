{
  "name": "game-strategy",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite --host 0.0.0.0",
    "build": "tsc -b && vite build",
    "preview": "vite preview --host 0.0.0.0",
    "test": "vitest run",
    "test:db": "node tests/database.integration.mjs",
    "check": "npm run test && npm run test:db && npm run build",
    "bootstrap": "node scripts/bootstrap.mjs",
    "test:edge": "deno check supabase/functions/game-command/index.ts supabase/functions/admin-users/index.ts supabase/functions/auth-session/index.ts supabase/functions/engine-tick/index.ts",
    "test:live": "node scripts/live-smoke.mjs",
    "format": "prettier --write src scripts tests *.ts *.json .github/workflows/*.yml docs/*.md README.md"
  },
  "engines": {
    "node": ">=22.12"
  },
  "dependencies": {
    "@fontsource/vazirmatn": "5.3.0",
    "@radix-ui/react-dialog": "1.3.1",
    "@radix-ui/react-slot": "1.5.0",
    "@radix-ui/react-tooltip": "1.4.1",
    "@supabase/supabase-js": "2.118.0",
    "@tanstack/react-query": "5.104.5",
    "class-variance-authority": "0.7.1",
    "clsx": "2.1.1",
    "lucide-react": "1.61.0",
    "motion": "14.6.0",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "react-router-dom": "7.18.4",
    "recharts": "3.10.1",
    "tailwind-merge": "3.7.0",
    "zod": "4.6.7",
    "zustand": "5.0.16"
  },
  "devDependencies": {
    "@electric-sql/pglite": "0.5.11",
    "@tailwindcss/vite": "4.3.3",
    "@testing-library/jest-dom": "7.0.1",
    "@testing-library/react": "16.3.3",
    "@types/node": "26.6.5",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitejs/plugin-react": "6.1.2",
    "deno": "2.9.6",
    "jsdom": "30.1.3",
    "prettier": "3.9.10",
    "supabase": "2.81.2",
    "tailwindcss": "4.3.3",
    "typescript": "5.9.3",
    "vite": "8.3.5",
    "vitest": "5.0.5"
  }
}
